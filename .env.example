# Kaggle API Credentials for Vietnam Music Genre dataset
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional metadata & lyrics tokens
GENIUS_ACCESS_TOKEN=your_genius_token_optional
SPOTIFY_CLIENT_ID=your_spotify_client_id_optional
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_optional

# Pipeline Settings
LOG_LEVEL=INFO
